{
  "name": "medicalfield-client",
  "version": "1.0.0",
  "private": true,
  "description": "MedicalField offline-first client for first responders (Electron + React + SQLite).",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
