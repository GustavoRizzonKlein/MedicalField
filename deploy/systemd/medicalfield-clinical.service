[Unit]
Description=MedicalField clinical service (Java)
After=network.target mysql.service medicalfield-identity.service

[Service]
User=univates
WorkingDirectory=/opt/medicalfield/clinical-service
# DB_PASSWORD and JWT_PUBLIC_KEY_PATH, readable only by the service user
EnvironmentFile=/opt/medicalfield/clinical-service/.env
ExecStart=/usr/bin/java -Xmx384m -jar build/libs/MedicalField-0.0.1-SNAPSHOT.jar
Restart=on-failure

[Install]
WantedBy=multi-user.target
