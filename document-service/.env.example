# Copy to .env and adjust. Values below are local development defaults.
PORT=8082
DB_HOST=localhost
DB_PORT=3306
DB_USER=medicalfield
DB_PASSWORD=medicalfield_dev
DB_NAME=medicalfield_documents

JWT_PUBLIC_KEY_PATH=../keys/jwt-public.pem
CLINICAL_SERVICE_URL=http://localhost:8080

# EMAIL_MODE=file writes each e-mail as an .eml file in EMAIL_OUTBOX_DIR (no real sending).
# EMAIL_MODE=smtp sends through the SMTP server below (use for the presentation).
EMAIL_MODE=file
EMAIL_OUTBOX_DIR=outbox
EMAIL_FROM=MedicalField <no-reply@medicalfield.local>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
