# Copy to .env and adjust. Values below are local development defaults.
PORT=8081
DB_HOST=localhost
DB_PORT=3306
DB_USER=medicalfield
DB_PASSWORD=medicalfield_dev
DB_NAME=medicalfield_identity

# RSA keys are generated on first start if they do not exist.
# The other services read only the public key.
JWT_PRIVATE_KEY_PATH=../keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=../keys/jwt-public.pem
TOKEN_TTL_HOURS=12

# Password given to the demo professionals created on first start (local test data).
SEED_PASSWORD=MedicalField@2026
